<Activity mc:Ignorable="sap sap2010" x:Class="Main"
 this:Main.in_SourceValue="ACME FOODS LTD."
 this:Main.in_ReferenceValues="Acme Foods Limited;Zenith Logistics LLC;Nordwind Handels GmbH;Sakura Trading Co;Acme Fabrics Limited"
 this:Main.in_Delimiter=";"
 this:Main.in_AutoMatchThreshold="90"
 this:Main.in_ReviewThreshold="75"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
 xmlns:this="clr-namespace:"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_SourceValue" Type="InArgument(x:String)" />
    <x:Property Name="in_ReferenceValues" Type="InArgument(x:String)" />
    <x:Property Name="in_Delimiter" Type="InArgument(x:String)" />
    <x:Property Name="in_AutoMatchThreshold" Type="InArgument(x:Double)" />
    <x:Property Name="in_ReviewThreshold" Type="InArgument(x:Double)" />
    <x:Property Name="out_MatchedValue" Type="OutArgument(x:String)" />
    <x:Property Name="out_Score" Type="OutArgument(x:Double)" />
    <x:Property Name="out_Outcome" Type="OutArgument(x:String)" />
    <x:Property Name="out_RunnerUpValue" Type="OutArgument(x:String)" />
    <x:Property Name="out_Margin" Type="OutArgument(x:Double)" />
  </x:Members>
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>FuzzyMatch</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Fuzzy Match Process" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="strSourceValue" />
      <Variable x:TypeArguments="x:String" Name="strReferenceValues" />
      <Variable x:TypeArguments="x:String" Name="strDelimiter" />
    </Sequence.Variables>
    <Assign x:TypeArguments="x:String" DisplayName="Assign Source Value" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="strSourceValue" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_SourceValue" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Assign Reference Values" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="strReferenceValues" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="in_ReferenceValues" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Assign Delimiter" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">
          <VisualBasicReference x:TypeArguments="x:String" ExpressionText="strDelimiter" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">
          <VisualBasicValue x:TypeArguments="x:String" ExpressionText="If(String.IsNullOrEmpty(in_Delimiter), &quot;;&quot;, in_Delimiter)" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log Run Start" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_1">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;Fuzzy match started. Source value: &quot;&quot;&quot; &amp; strSourceValue &amp; &quot;&quot;&quot; | Auto-match &gt;= &quot; &amp; in_AutoMatchThreshold.ToString() &amp; &quot;, review &gt;= &quot; &amp; in_ReviewThreshold.ToString()" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <TryCatch DisplayName="Try Catch Fuzzy Match" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:InvokeWorkflowFile DisplayName="Invoke Fuzzy Matcher" WorkflowFileName="MatchValue.cs" UnSafe="False" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1">
            <ui:InvokeWorkflowFile.Arguments>
              <scg:Dictionary x:TypeArguments="x:String, Argument">
                <InArgument x:TypeArguments="x:String" x:Key="sourceValue">
                  <VisualBasicValue x:TypeArguments="x:String" ExpressionText="strSourceValue" />
                </InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="referenceValues">
                  <VisualBasicValue x:TypeArguments="x:String" ExpressionText="strReferenceValues" />
                </InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="delimiter">
                  <VisualBasicValue x:TypeArguments="x:String" ExpressionText="strDelimiter" />
                </InArgument>
                <InArgument x:TypeArguments="x:Double" x:Key="autoMatchThreshold">
                  <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="in_AutoMatchThreshold" />
                </InArgument>
                <InArgument x:TypeArguments="x:Double" x:Key="reviewThreshold">
                  <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="in_ReviewThreshold" />
                </InArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="MatchedValue">
                  <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_MatchedValue" />
                </OutArgument>
                <OutArgument x:TypeArguments="x:Double" x:Key="Score">
                  <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="out_Score" />
                </OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="Outcome">
                  <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_Outcome" />
                </OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="RunnerUpValue">
                  <VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_RunnerUpValue" />
                </OutArgument>
                <OutArgument x:TypeArguments="x:Double" x:Key="Margin">
                  <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="out_Margin" />
                </OutArgument>
              </scg:Dictionary>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:LogMessage DisplayName="Log Match Result" Level="Info" sap2010:WorkflowViewState.IdRef="LogMessage_2">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">
                <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;Outcome: &quot; &amp; out_Outcome &amp; &quot; | Matched: &quot;&quot;&quot; &amp; out_MatchedValue &amp; &quot;&quot;&quot; | Score: &quot; &amp; out_Score.ToString() &amp; &quot; | Runner-up: &quot;&quot;&quot; &amp; out_RunnerUpValue &amp; &quot;&quot;&quot; | Margin: &quot; &amp; out_Margin.ToString()" />
              </InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
          <If sap2010:WorkflowViewState.IdRef="If_1" DisplayName="If Not Auto Matched">
            <If.Condition>
              <InArgument x:TypeArguments="x:Boolean">
                <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="out_Outcome &lt;&gt; &quot;AutoMatched&quot;" />
              </InArgument>
            </If.Condition>
            <If.Then>
              <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
                <ui:LogMessage DisplayName="Log Review Required" Level="Warn" sap2010:WorkflowViewState.IdRef="LogMessage_3">
                  <ui:LogMessage.Message>
                    <InArgument x:TypeArguments="x:Object">
                      <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;&quot;&quot;&quot; &amp; strSourceValue &amp; &quot;&quot;&quot; was not auto-matched (outcome: &quot; &amp; out_Outcome &amp; &quot;, score: &quot; &amp; out_Score.ToString() &amp; &quot;). A human decision is needed.&quot;" />
                    </InArgument>
                  </ui:LogMessage.Message>
                </ui:LogMessage>
              </Sequence>
            </If.Then>
          </If>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_1">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch" sap2010:WorkflowViewState.IdRef="Sequence_4">
              <ui:LogMessage DisplayName="Log Failure" Level="Error" sap2010:WorkflowViewState.IdRef="LogMessage_4">
                <ui:LogMessage.Message>
                  <InArgument x:TypeArguments="x:Object">
                    <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;Fuzzy match failed: &quot; &amp; exception.GetType().Name &amp; &quot; - &quot; &amp; exception.Message" />
                  </InArgument>
                </ui:LogMessage.Message>
              </ui:LogMessage>
              <Rethrow DisplayName="Rethrow" sap2010:WorkflowViewState.IdRef="Rethrow_1" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
  </Sequence>
</Activity>
